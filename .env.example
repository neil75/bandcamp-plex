# Copy to /etc/bandcamp-plex/bandcamp-plex.conf and edit.
# Only BANDCAMP_USERNAME is strictly required.

# ---- Bandcamp ----------------------------------------------------------------
# The username that appears in https://bandcamp.com/<username>
BANDCAMP_USERNAME=your_bandcamp_fan_username

# Path to a Netscape-format cookies.txt exported from a browser that is logged
# in to Bandcamp.
BANDCAMP_COOKIES_FILE=/etc/bandcamp-plex/cookies.txt

# Preferred audio format. Falls back to the best available if unavailable.
# Options: flac, alac, wav, aiff-lossless, mp3-v0, mp3-320, vorbis, aac-hi
BANDCAMP_FORMAT=flac

# ---- Plex --------------------------------------------------------------------
# Optional. If PLEX_URL is set, the service queries Plex directly for the list
# of albums and triggers a library scan after new downloads are installed. If
# omitted, it scans MUSIC_DIR on the filesystem instead.
PLEX_URL=http://localhost:32400
# Token is optional — leave blank if your Plex server allows unauthenticated
# local access (the default for most home setups).
PLEX_TOKEN=
PLEX_LIBRARY=Music

# ---- Filesystem --------------------------------------------------------------
# Where the Plex music library lives on this machine.
MUSIC_DIR=/srv/music
# Temporary space for downloaded zip files.
DOWNLOAD_DIR=/var/tmp/bandcamp-plex
# Persistent record of items already synced.
STATE_FILE=/var/lib/bandcamp-plex/state.json

# ---- Loop --------------------------------------------------------------------
# Seconds between sync runs. Set to 0 to run exactly once and exit.
CHECK_INTERVAL=3600
# When true, log missing albums but don't download anything.
DRY_RUN=false
# When true, missing items are written to a review HTML file for approval
# instead of being downloaded automatically. Place the resulting decisions.json
# in the state directory to approve/skip items on the next run.
APPROVAL_MODE=false
