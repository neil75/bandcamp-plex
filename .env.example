# Copy to .env and edit to taste. Only BANDCAMP_USERNAME is strictly required;
# every other setting has a sensible default for the Docker image.

# ---- Bandcamp ----------------------------------------------------------------
# The username that appears in https://bandcamp.com/<username>
BANDCAMP_USERNAME=your_bandcamp_fan_username

# Path to a Netscape-format cookies.txt exported from a browser that is logged
# in to Bandcamp. Inside the container this defaults to /config/cookies.txt.
BANDCAMP_COOKIES_FILE=/config/cookies.txt

# Preferred audio format. Falls back to the best available if unavailable.
# Options: flac, alac, wav, aiff-lossless, mp3-v0, mp3-320, vorbis, aac-hi
BANDCAMP_FORMAT=flac

# ---- Plex --------------------------------------------------------------------
# Optional. If set, the service queries Plex directly for the list of albums
# and triggers a library scan after new downloads are installed. If omitted,
# it scans MUSIC_DIR on the filesystem instead.
PLEX_URL=http://plex:32400
PLEX_TOKEN=
PLEX_LIBRARY=Music

# ---- Filesystem --------------------------------------------------------------
# Where the Plex music library lives (mount your Unraid share here).
MUSIC_DIR=/music
# Temporary space for downloaded zip files.
DOWNLOAD_DIR=/downloads
# Persistent record of items already synced.
STATE_FILE=/config/state.json

# ---- Loop --------------------------------------------------------------------
# Seconds between sync runs. Set to 0 to run exactly once and exit.
CHECK_INTERVAL=3600
# When true, log missing albums but don't download anything.
DRY_RUN=false
