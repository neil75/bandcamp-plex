[Unit]
Description=Bandcamp → Plex music sync
After=network-online.target remote-fs.target
Wants=network-online.target remote-fs.target

[Service]
Type=simple
User=bandcamp-plex
Group=bandcamp-plex

EnvironmentFile=/etc/bandcamp-plex/bandcamp-plex.conf

ExecStart=/opt/bandcamp-plex/venv/bin/python -m src
WorkingDirectory=/opt/bandcamp-plex

Restart=on-failure
RestartSec=30

# Hardening — ProtectSystem=full protects /usr and /boot but leaves /srv,
# /var, /media, /mnt writable so MUSIC_DIR doesn't need to exist at unit
# load time and external drives work without extra ReadWritePaths config.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
